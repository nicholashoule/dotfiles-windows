{
  "platforms": ["windows"],
  "setup": [
    {
      "name": "profile",
      "run": ["pwsh", "-NoLogo", "-NoProfile", "-File", "home/.local/share/helpers/pwsh/init-profile.ps1"],
      "creates": "{documents}/PowerShell/profile.ps1"
    },
    {
      "name": "local",
      "run": ["pwsh", "-NoLogo", "-NoProfile", "-File", "home/.local/share/helpers/pwsh/init-local.ps1"],
      "creates": ".config/powershell/profile.d/local.ps1"
    },
    {
      "name": "scoop-config",
      "run": ["pwsh", "-NoLogo", "-NoProfile", "-File", "home/.local/share/helpers/pwsh/init-scoop-config.ps1"],
      "creates": ".config/scoop/config.json"
    },
    {
      "name": "wsl-gitconfig",
      "run": ["bash", "home/wsl/.local/share/helpers/sh/init-gitconfig.sh"],
      "platforms": ["linux"],
      "creates": ".gitconfig"
    },
    {
      "name": "wsl-local",
      "run": ["bash", "home/wsl/.local/share/helpers/sh/init-local.sh"],
      "platforms": ["linux"],
      "creates": ".bashrc.d/local.sh"
    }
  ]
}
