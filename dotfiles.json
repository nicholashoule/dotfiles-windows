{
  "platforms": ["windows"],
  "setup": [
    {
      "name": "powershell",
      "run": [
        "winget", "install", "--id", "Microsoft.PowerShell", "--exact", "--source", "winget",
        "--accept-source-agreements", "--accept-package-agreements"
      ],
      "provides": "pwsh"
    },
    {
      "name": "local",
      "run": ["pwsh", "-NoLogo", "-NoProfile", "-File", "home/.local/share/helpers/pwsh/init-local.ps1"],
      "creates": ".config/powershell/profile.d/local.ps1"
    },
    {
      "name": "scoop-config",
      "run": ["pwsh", "-NoLogo", "-NoProfile", "-File", "home/.local/share/helpers/pwsh/init-scoop-config.ps1"],
      "creates": ".config/scoop/config.json"
    },
    {
      "name": "winget-tools",
      "run": [
        "pwsh", "-NoLogo", "-NoProfile", "-File", "home/.local/share/helpers/pwsh/install-tools.ps1",
        "-Path", "home/.config/winget/tools.psd1"
      ]
    },
    {
      "name": "meslo-nerd-font",
      "run": ["oh-my-posh", "font", "install", "Meslo"],
      "creates": "AppData/Local/Microsoft/Windows/Fonts/MesloLGMNerdFont-Regular.ttf"
    }
  ]
}
