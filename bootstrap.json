{
  "platforms": ["windows"],
  "setup": [
    {
      "name": "powershell",
      "run": [
        "winget", "install", "--id", "Microsoft.PowerShell", "--exact", "--source", "winget",
        "--accept-source-agreements", "--accept-package-agreements"
      ],
      "provides": "pwsh"
    },
    {
      "name": "winget-tools",
      "run": [
        "pwsh", "-NoLogo", "-NoProfile", "-File", "home/.local/share/helpers/pwsh/install-tools.ps1",
        "-Path", "home/.config/winget/tools.psd1", "-NoUpgrade"
      ]
    },
    {
      "name": "meslo-nerd-font",
      "run": ["oh-my-posh", "font", "install", "Meslo"],
      "creates": "AppData/Local/Microsoft/Windows/Fonts/MesloLGMNerdFont-Regular.ttf"
    },
    {
      "name": "dotnet-sdk",
      "run": ["pwsh", "-NoLogo", "-NoProfile", "-File", "home/.local/share/helpers/pwsh/install-dotnet.ps1"],
      "creates": ".dotnet/dotnet.exe"
    },
    {
      "name": "go",
      "run": ["pwsh", "-NoLogo", "-NoProfile", "-File", "home/.local/share/helpers/pwsh/install-golang.ps1"],
      "provides": "go"
    },
    {
      "name": "wsl-apt-packages",
      "run": ["bash", "home/wsl/.local/share/helpers/sh/install-apt-packages.sh", "home/wsl/.config/apt/packages"],
      "platforms": ["linux"]
    },
    {
      "name": "wsl-oh-my-posh",
      "run": ["bash", "home/wsl/.local/share/helpers/sh/install-oh-my-posh.sh"],
      "platforms": ["linux"],
      "provides": "oh-my-posh"
    },
    {
      "name": "wsl-dotnet-sdk",
      "run": ["bash", "home/wsl/.local/share/helpers/sh/install-dotnet.sh"],
      "platforms": ["linux"],
      "creates": ".dotnet/dotnet"
    },
    {
      "name": "wsl-go",
      "run": ["bash", "home/wsl/.local/share/helpers/sh/install-go.sh"],
      "platforms": ["linux"],
      "creates": ".local/share/go/bin/go"
    }
  ]
}
